{
  "name": "@aficax/core",
  "version": "0.1.0",
  "private": true,
  "description": "Shared types and utilities used by the Aficax server and TUI.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./types": {
      "types": "./src/types/index.ts",
      "import": "./src/types/index.ts"
    },
    "./utils": {
      "types": "./src/utils/index.ts",
      "import": "./src/utils/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir dist --target bun --format esm",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .tsbuildinfo",
    "test": "bun test tests/"
  },
  "devDependencies": {
    "@types/bun": "^1.1.6",
    "@types/node": "^20.12.7",
    "typescript": "^5.4.5"
  }
}
